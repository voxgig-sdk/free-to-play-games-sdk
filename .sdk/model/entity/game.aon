# Entity: game

main: kit: entity: game: {

  alias: field: {}

  fields: [
    {
      name: "description"
      req: false
      short: "Full description of the game"
      type: "`$STRING`"
    }
    {
      name: "developer"
      req: false
      short: "Developer of the game"
      type: "`$STRING`"
    }
    {
      format: "uri"
      name: "freetogame_profile_url"
      req: false
      short: "URL to the game's profile page on FreeToGame"
      type: "`$STRING`"
    }
    {
      format: "uri"
      name: "game_url"
      req: false
      short: "URL to play or download the game"
      type: "`$STRING`"
    }
    {
      name: "genre"
      req: false
      short: "Genre or category of the game"
      type: "`$STRING`"
    }
    {
      name: "id"
      req: false
      short: "Unique identifier for the game"
      type: "`$INTEGER`"
    }
    {
      name: "minimum_system_requirements"
      req: false
      short: "Minimum system requirements for PC games"
      type: "`$OBJECT`"
    }
    {
      name: "platform"
      req: false
      short: "Platform(s) the game is available on"
      type: "`$STRING`"
    }
    {
      name: "publisher"
      req: false
      short: "Publisher of the game"
      type: "`$STRING`"
    }
    {
      format: "date"
      name: "release_date"
      req: false
      short: "Release date of the game in YYYY-MM-DD format"
      type: "`$STRING`"
    }
    {
      name: "screenshots"
      req: false
      short: "Array of screenshot images"
      type: "`$ARRAY`"
    }
    {
      name: "short_description"
      req: false
      short: "Brief description of the game"
      type: "`$STRING`"
    }
    {
      name: "status"
      req: false
      short: "Current status of the game (e.g., Live, Beta)"
      type: "`$STRING`"
    }
    {
      format: "uri"
      name: "thumbnail"
      req: false
      short: "URL to the game's thumbnail image"
      type: "`$STRING`"
    }
    {
      name: "title"
      req: false
      short: "Title of the game"
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "game"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            query: [
              {
                kind: "query"
                name: "category"
                orig: "category"
                reqd: false
                type: "`$STRING`"
              }
              {
                example: "all"
                kind: "query"
                name: "platform"
                orig: "platform"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "sort_by"
                orig: "sort_by"
                reqd: false
                type: "`$STRING`"
              }
            ]
          }
          contract: {
            id: "GET /games"
            json: "{\"operationId\":\"getGames\",\"parameters\":[{\"description\":\"Filter games by platform (e.g., pc, browser, all)\",\"in\":\"query\",\"name\":\"platform\",\"required\":false,\"schema\":{\"default\":\"all\",\"enum\":[\"pc\",\"browser\",\"all\"],\"type\":\"string\"}},{\"description\":\"Filter games by category/genre (e.g., mmorpg, shooter, strategy, moba, racing, sports, social, sandbox, open-world, survival, pvp, pve, pixel, voxel, zombie, turn-based, first-person, third-person, top-down, tank, space, sailing, side-scroller, superhero, permadeath, card, battle-royale, mmo, mmofps, mmotps, 3d, 2d, anime, fantasy, sci-fi, fighting, action-rpg, action, military, martial-arts, flight, low-spec, tower-defense, horror, mmorts)\",\"in\":\"query\",\"name\":\"category\",\"required\":false,\"schema\":{\"type\":\"string\"}},{\"description\":\"Sort games by criteria (e.g., release-date, popularity, alphabetical, relevance)\",\"in\":\"query\",\"name\":\"sort-by\",\"required\":false,\"schema\":{\"enum\":[\"release-date\",\"popularity\",\"alphabetical\",\"relevance\"],\"type\":\"string\"}}],\"protocol\":\"http\",\"responses\":{\"200\":{\"content\":{\"application/json\":{\"example\":[{\"developer\":\"Blizzard Entertainment\",\"freetogame_profile_url\":\"https://www.freetogame.com/overwatch-2\",\"game_url\":\"https://www.freetogame.com/open/overwatch-2\",\"genre\":\"Shooter\",\"id\":540,\"platform\":\"PC (Windows)\",\"publisher\":\"Activision Blizzard\",\"release_date\":\"2022-10-04\",\"short_description\":\"A hero-focused first-person team shooter from Blizzard Entertainment.\",\"thumbnail\":\"https://www.freetogame.com/g/540/thumbnail.jpg\",\"title\":\"Overwatch 2\"}],\"schema\":{\"items\":{\"properties\":{\"developer\":{\"description\":\"Developer of the game\",\"type\":\"string\"},\"freetogame_profile_url\":{\"description\":\"URL to the game's profile page on FreeToGame\",\"format\":\"uri\",\"type\":\"string\"},\"game_url\":{\"description\":\"URL to play or download the game\",\"format\":\"uri\",\"type\":\"string\"},\"genre\":{\"description\":\"Genre or category of the game\",\"type\":\"string\"},\"id\":{\"description\":\"Unique identifier for the game\",\"type\":\"integer\"},\"platform\":{\"description\":\"Platform(s) the game is available on\",\"type\":\"string\"},\"publisher\":{\"description\":\"Publisher of the game\",\"type\":\"string\"},\"release_date\":{\"description\":\"Release date of the game in YYYY-MM-DD format\",\"format\":\"date\",\"type\":\"string\"},\"short_description\":{\"description\":\"Brief description of the game\",\"type\":\"string\"},\"thumbnail\":{\"description\":\"URL to the game's thumbnail image\",\"format\":\"uri\",\"type\":\"string\"},\"title\":{\"description\":\"Title of the game\",\"type\":\"string\"}},\"type\":\"object\"},\"type\":\"array\"}}},\"description\":\"Successful response with list of games\"},\"500\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"message\":{\"description\":\"Error message\",\"type\":\"string\"},\"status\":{\"description\":\"HTTP status code\",\"type\":\"integer\"}},\"type\":\"object\"}}},\"description\":\"Internal server error\"}},\"securitySource\":\"unspecified\"}"
            source: "openapi3"
            version: 1
          }
          method: "GET"
          orig: "/games"
          segments: [
            {
              lit: "games"
            }
          ]
          select: {
            exist: [
              "category"
              "platform"
              "sort_by"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          args: {
            query: [
              {
                kind: "query"
                name: "id"
                orig: "id"
                reqd: true
                type: "`$INTEGER`"
              }
            ]
          }
          contract: {
            id: "GET /game"
            json: "{\"operationId\":\"getGameById\",\"parameters\":[{\"description\":\"The ID of the game to retrieve\",\"in\":\"query\",\"name\":\"id\",\"required\":true,\"schema\":{\"type\":\"integer\"}}],\"protocol\":\"http\",\"responses\":{\"200\":{\"content\":{\"application/json\":{\"example\":{\"description\":\"Overwatch 2 is a free-to-play, team-based action game set in the optimistic future...\",\"developer\":\"Blizzard Entertainment\",\"freetogame_profile_url\":\"https://www.freetogame.com/overwatch-2\",\"game_url\":\"https://www.freetogame.com/open/overwatch-2\",\"genre\":\"Shooter\",\"id\":540,\"minimum_system_requirements\":{\"graphics\":\"NVIDIA GeForce GTX 600 series, AMD Radeon HD 7000 series\",\"memory\":\"6 GB RAM\",\"os\":\"Windows 10 64-bit\",\"processor\":\"Intel Core i3 or AMD Phenom X3 8650\",\"storage\":\"50 GB\"},\"platform\":\"Windows\",\"publisher\":\"Activision Blizzard\",\"release_date\":\"2022-10-04\",\"screenshots\":[{\"id\":1,\"image\":\"https://www.freetogame.com/g/540/screenshot1.jpg\"}],\"short_description\":\"A hero-focused first-person team shooter from Blizzard Entertainment.\",\"status\":\"Live\",\"thumbnail\":\"https://www.freetogame.com/g/540/thumbnail.jpg\",\"title\":\"Overwatch 2\"},\"schema\":{\"allOf\":[{\"properties\":{\"developer\":{\"description\":\"Developer of the game\",\"type\":\"string\"},\"freetogame_profile_url\":{\"description\":\"URL to the game's profile page on FreeToGame\",\"format\":\"uri\",\"type\":\"string\"},\"game_url\":{\"description\":\"URL to play or download the game\",\"format\":\"uri\",\"type\":\"string\"},\"genre\":{\"description\":\"Genre or category of the game\",\"type\":\"string\"},\"id\":{\"description\":\"Unique identifier for the game\",\"type\":\"integer\"},\"platform\":{\"description\":\"Platform(s) the game is available on\",\"type\":\"string\"},\"publisher\":{\"description\":\"Publisher of the game\",\"type\":\"string\"},\"release_date\":{\"description\":\"Release date of the game in YYYY-MM-DD format\",\"format\":\"date\",\"type\":\"string\"},\"short_description\":{\"description\":\"Brief description of the game\",\"type\":\"string\"},\"thumbnail\":{\"description\":\"URL to the game's thumbnail image\",\"format\":\"uri\",\"type\":\"string\"},\"title\":{\"description\":\"Title of the game\",\"type\":\"string\"}},\"type\":\"object\"},{\"properties\":{\"description\":{\"description\":\"Full description of the game\",\"type\":\"string\"},\"minimum_system_requirements\":{\"description\":\"Minimum system requirements for PC games\",\"properties\":{\"graphics\":{\"description\":\"Graphics card requirement\",\"type\":\"string\"},\"memory\":{\"description\":\"Memory (RAM) requirement\",\"type\":\"string\"},\"os\":{\"description\":\"Operating system requirement\",\"type\":\"string\"},\"processor\":{\"description\":\"Processor requirement\",\"type\":\"string\"},\"storage\":{\"description\":\"Storage space requirement\",\"type\":\"string\"}},\"type\":\"object\"},\"screenshots\":{\"description\":\"Array of screenshot images\",\"items\":{\"properties\":{\"id\":{\"description\":\"Screenshot identifier\",\"type\":\"integer\"},\"image\":{\"description\":\"URL to the screenshot image\",\"format\":\"uri\",\"type\":\"string\"}},\"type\":\"object\"},\"type\":\"array\"},\"status\":{\"description\":\"Current status of the game (e.g., Live, Beta)\",\"type\":\"string\"}},\"type\":\"object\"}]}}},\"description\":\"Successful response with game details\"},\"404\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"message\":{\"description\":\"Error message\",\"type\":\"string\"},\"status\":{\"description\":\"HTTP status code\",\"type\":\"integer\"}},\"type\":\"object\"}}},\"description\":\"Game not found\"},\"500\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"message\":{\"description\":\"Error message\",\"type\":\"string\"},\"status\":{\"description\":\"HTTP status code\",\"type\":\"integer\"}},\"type\":\"object\"}}},\"description\":\"Internal server error\"}},\"securitySource\":\"unspecified\"}"
            source: "openapi3"
            version: 1
          }
          method: "GET"
          orig: "/game"
          segments: [
            {
              lit: "game"
            }
          ]
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
